# Copy this file to `.env` and fill the two secrets. `.env` is never committed.
#
#   cp .env.example .env
#   openssl rand -hex 32     # run it twice: one value per secret below

# Signs the login tokens (at least 32 characters). The API refuses to start without it.
JWT_SECRET=

# Password of the database user. Use letters and digits only (hex is fine), because it goes
# inside a connection URL.
POSTGRES_PASSWORD=

# Let anyone create an account? Set to false once your own account exists.
ALLOW_REGISTRATION=true

# Port of the app on this machine: http://localhost:8080
WEB_PORT=8080
